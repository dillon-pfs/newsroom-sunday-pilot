# ESPN works without a key. Keep all credentials server-only.
BALLDONTLIE_API_KEY=

# Optional outage smoke check: none | espn | all. Honored only in local dev
# or Vercel Preview. Ignored in production. Clear after testing.
NFL_SMOKE_OUTAGE=

# Required for production; local development uses in-memory storage if omitted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Desk mail via Resend. Preview/Production values live on Vercel — do not commit secrets.
# After poorformsports.com is verified in Resend, MAIL_FROM can become a desk@ address.
RESEND_API_KEY=
MAIL_TO=
MAIL_FROM=

# Optional: all three together pin a historical/current NFL week.
# Season types: 1 preseason, 2 regular season, 3 postseason.
# NFL_SEASON=2026
# NFL_SEASON_TYPE=2
# NFL_WEEK=2
